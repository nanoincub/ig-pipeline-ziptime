# Worker de upload (ig-assets). Copie para .env e preencha com os valores reais.
IG_UPLOAD_ENDPOINT=
IG_UPLOAD_TOKEN=

# Publicação no Instagram via Graph API (comando `ig-render publish`).
# IG_USER_ID: id da conta Instagram Business/Creator (Instagram User ID).
# IG_ACCESS_TOKEN: token de acesso de longa duração com permissões de publicação.
# IG_GRAPH_HOST: host da Graph API. Default graph.instagram.com (Instagram API
#   with Instagram Login). Use graph.facebook.com para o caminho via Facebook Login.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_HOST=graph.instagram.com

# Cofre de tokens no worker (comandos `ig-render token:set` / `token:status`).
# IG_ADMIN_TOKEN: segredo de administração do worker (mesmo valor do secret
#   ADMIN_TOKEN do worker). Gere com `openssl rand -hex 32`. Usado só para
#   cadastrar/renovar tokens; a leitura de status aceita IG_UPLOAD_TOKEN.
IG_ADMIN_TOKEN=
