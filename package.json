{
  "name": "ig-pipeline",
  "version": "0.1.0",
  "description": "Renderizador de criativos de Instagram (imagem única e carrossel) a partir de JSON, com Satori + resvg. Multi-marca via tokens.",
  "type": "module",
  "bin": {
    "ig-render": "dist/cli.js"
  },
  "scripts": {
    "fetch-fonts": "bash scripts/fetch-fonts.sh",
    "build": "tsc -p tsconfig.json",
    "ig-render": "node dist/cli.js",
    "dev": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "commander": "^12.1.0",
    "satori": "^0.12.1",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "react": "^18.3.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
